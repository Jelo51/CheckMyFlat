{
  "name": "checkmyflat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > app/types/database.types.ts && prettier --write app/types/database.types.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "browser-image-compression": "^2.0.2",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "pdfkit": "^0.20.2",
    "resend": "^6.30.0",
    "stripe": "^22.6.2",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase",
      "unrs-resolver",
      "@parcel/watcher"
    ],
    "overrides": {
      "typescript": "^6.0.3"
    }
  }
}
