# --- Supabase -----------------------------------------------------------------
# URL et clé publique (anon / publishable) : exposées au navigateur.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=
# Clé service role : utilisée UNIQUEMENT par le serveur (dossier server/).
# Clé secrète (sb_secret_…) ou ancienne clé service_role.
NUXT_SUPABASE_SECRET_KEY=

# --- Application --------------------------------------------------------------
# URL publique du site (liens des emails, retours Stripe).
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret des tâches planifiées déclenchées par un cron externe (openssl rand -hex 32).
NUXT_CRON_SECRET=

# --- Stripe -------------------------------------------------------------------
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
NUXT_STRIPE_SECRET_KEY=sk_test_
# Affiché par `stripe listen --forward-to localhost:3000/webhooks/stripe`.
NUXT_STRIPE_WEBHOOK_SECRET=whsec_

# --- Emails (Resend) ----------------------------------------------------------
# `log` écrit les emails dans la console (local, tests) ; `resend` les envoie.
NUXT_EMAIL_PROVIDER=log
NUXT_RESEND_API_KEY=re_
# Adresse d'expédition vérifiée dans Resend, ex. « CheckMyFlat <notifications@votre-domaine.fr> ».
NUXT_EMAIL_FROM=
